# ─────────────────────────────────────────────────────────────
# FinanceIQ — Environment Variables
# Copy this file to `.env` and fill in your keys.
# `.env` is git-ignored; never commit real keys.
# ─────────────────────────────────────────────────────────────

# ── Market data (REQUIRED for fundamentals & ratios) ─────────
FMP_API_KEY=your_fmp_api_key_here

# ── Optional but recommended ─────────────────────────────────
FINNHUB_API_KEY=                 # analyst ratings, insider, earnings
FRED_API_KEY=                    # macroeconomic indicators
ALPHA_VANTAGE_KEY=               # sector heatmap, currency conversion

# ── AI backend ───────────────────────────────────────────────
# Local Ollama is tried first; if unreachable, Gemini is used.
# At least ONE of the two should be configured.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=120               # seconds
GEMINI_API_KEY=                  # required if Ollama is not installed

# ── Flask runtime ────────────────────────────────────────────
FLASK_ENV=production             # set to "development" to expose error details
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# ── Rate limiting (per IP) ───────────────────────────────────
RATE_LIMIT_DEFAULT=120/minute    # default cap on every endpoint
RATE_LIMIT_SUGGEST=30/minute     # autocomplete (fires per keystroke)
RATE_LIMIT_ANALYZE=10/minute     # full analysis (expensive)

# ── Zerodha Kite Connect (optional, unused by default) ───────
# KITE_API_KEY=
# KITE_API_SECRET=
